{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openag-signin",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Only the production address serves callbacks; per-version preview URLs add nothing.
  "preview_urls": false,
  // Callback URLs contain authorization codes. Never collect invocation URLs or traces.
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "RelaySession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelaySession"] }],
  "ratelimits": [
    { "name": "REQUEST_LIMIT", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } },
    { "name": "REQUEST_TOTAL_LIMIT", "namespace_id": "1004", "simple": { "limit": 12000, "period": 60 } },
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "TOTAL_LIMIT", "namespace_id": "1002", "simple": { "limit": 1000, "period": 60 } }
  ]
}
